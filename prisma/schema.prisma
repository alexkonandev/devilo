generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String         @id
  email                 String         @unique
  plan                  PlanStatus     @default(FREE)
  profession            Profession?
  businessModel         BusinessModel?
  companyName           String?
  companyLogo           String?
  taxId                 String?
  taxIdLabel            String?        @default("NCC")
  companyEmail          String?
  companyPhone          String?
  companyWebsite        String?
  currency              Currency       @default(XOF)
  defaultVatRate        Float          @default(18.0)
  quotePrefix           String         @default("INV-")
  nextQuoteNumber       Int            @default(1)
  defaultTerms          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  companyAddressDetails String?
  companyCity           String?

  // --- CHAMPS BANCAIRES (Phase 2 - Géo-spécifique) ---
  paymentZone           PaymentZone    @default(AFRI)
  bankName              String?
  bankIBAN              String?
  bankSWIFT             String?
  bankBIC               String?
  bankRoutingNumber     String?
  bankAccountNumber     String?
  showBankDetailsOnQuotes Boolean      @default(false)
  deletedAt             DateTime?
  catalogOffers         CatalogOffer[]
  clients               Client[]
  clientActivities      ClientActivity[]
  subscription          Subscription?
  userServices          UserService[]
  quotes                Quote[]
  quoteEvents           QuoteEvent[]

  @@map("users")
}

model UserApiLimit {
  id        String   @id @default(cuid())
  userId    String   @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id             String    @id @default(cuid())
  userId         String    @unique
  variantId      String?
  customerId     String?   @unique
  subscriptionId String?   @unique
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CatalogOffer {
  id        String      @id @default(cuid())
  category  String
  title     String
  subtitle  String      @default("")
  userId    String
  unitPrice Float
  isPremium Boolean     @default(false)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category])
}

model UserService {
  id        String   @id @default(cuid())
  userId    String
  title     String
  subtitle  String   @default("")
  unitPrice Float
  createdAt DateTime @default(now())
  baseCost  Float    @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, title])
}

model Client {
  id                   String   @id @default(cuid())
  userId               String
  name                 String
  email                String?
  phone                String?
  address              String?
  addressLine2         String?
  city                 String?
  postalCode           String?
  country              String   @default("CI")
  taxId                String?
  tvaNumber            String?
  legalForm            String?
  representativeName   String?
  representativePosition String?
  notes                String?
  tags                 String[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes    Quote[]
  activities ClientActivity[]

  @@index([userId])
  @@index([userId, taxId])
}

model ClientActivity {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  type      String
  content   String
  createdAt DateTime @default(now())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([userId, clientId])
}

model Quote {
  id             String      @id @default(cuid())
  userId         String
  clientId       String

  title          String      @default("NOUVEAU_PROJET")

  companyName    String?
  companyEmail   String?
  companyAddress String?
  companyTaxId   String?
  companyTaxIdL  String?
  companyWebsite String?

  clientName     String?
  clientEmail    String?
  clientAddress  String?
  clientTaxId    String?

  dueDate         DateTime?
  currency        Currency     @default(XOF)
  validityDays    Int          @default(30)

  paymentZone         String?     @default("AFRI")
  bankName            String?
  bankIBAN            String?
  bankSWIFT           String?
  bankBIC             String?
  bankRoutingNumber   String?
  bankAccountNumber   String?
  showBankDetails     Boolean     @default(false)

  number         String      @unique
  status         QuoteStatus @default(DRAFT)
  issueDate      DateTime    @default(now())
  vatRatePercent Float       @default(20)
  discount       Float       @default(0)
  terms          String?     @db.Text

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  lines          QuoteLine[]
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         QuoteEvent[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])

  @@map("quotes")
}

model QuoteLine {
  id        String @id @default(cuid())
  quoteId   String
  title     String
  subtitle  String @default("")
  quantity  Float  @default(1)
  unitPrice Float
  baseCost  Float  @default(0)
  quote     Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_lines")
}

model QuoteEvent {
  id        String      @id @default(cuid())
  quoteId   String
  userId    String
  quote     Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String      // created | sent | viewed | status_changed | reminder | note
  status    QuoteStatus?
  metadata  Json?
  createdAt DateTime    @default(now())
  createdBy String?

  @@index([quoteId])
  @@index([userId])
  @@index([createdAt])
  @@map("quote_events")
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String
  baseLayout  String
  config      Json
  isSystem    Boolean  @default(false)
  isPremium   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isSystem])
}

enum PlanStatus {
  FREE
  PRO
  ENTERPRISE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  PAID
  CANCELLED
}

enum Profession {
  TECH
  CREATIVE
  MARKETING
  CONTENT
  CONSULTING
}

enum PaymentZone {
  USA
  EUR
  AFRI
}

enum BusinessModel {
  PROJECT
  TIME
  RECURRING
  UNIT
}

enum Currency {
  XOF
  EUR
  USD
  GBP
  XAF
  MAD
  OTHER
}